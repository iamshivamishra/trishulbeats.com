# Services & Repositories

## Services (`src/lib/services/*.service.ts`)

- Contain business logic, authorization, orchestration.
- Call repositories — never import Mongoose models directly.
- Use `withTransaction()` for multi-step writes.
- Throw typed errors: `NotFoundError`, `ForbiddenError`, etc.
- Use `logger` for structured logging, `audit()` for important actions.

```typescript
export const beatService = {
  async create(input: CreateBeatInput, producerId: string): Promise<IBeat> {
    return withTransaction(async (session) => {
      const beat = await beatRepository.create({ ...input, producerId }, { session });
      await licenseRepository.createDefaults(beat._id.toString(), producerId, { session });
      audit("beat.created", { beatId: beat._id, producerId });
      return beat;
    });
  },
};
```

## Repositories (`src/lib/repositories/*.repository.ts`)

- Persistence only — no business rules.
- Always call `await connectDB()` before queries.
- Accept optional `{ session }` for transactions.
- Return `.lean()` for read queries.
- Use `.select()` to project only needed fields.

```typescript
export const beatRepository = {
  async findById(id: string) {
    await connectDB();
    return Beat.findById(id).lean<IBeat>();
  },

  async findByIds(ids: string[]) {
    await connectDB();
    return Beat.find({ _id: { $in: ids } }).lean<IBeat[]>();
  },
};
```
